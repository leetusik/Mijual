# Secrets
.env
.env.*

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# P2 pipeline: on-disk OpenDART response cache (regenerable; byte-compatible
# with the P1 spike cache below). Also holds the scheduler's file-lock fallback
# and (with `beat -s var/celerybeat-schedule`) beat's own last-run state.
var/

# P2.S6: celery beat's shelve DB when it is started without `-s var/...`.
celerybeat-schedule*
celerybeat.pid

# Node
node_modules/
.next/
dist/

# OS / editor
.DS_Store

# P1.S1 spike: raw DART response cache (~9MB, regenerable by re-running the scripts).
# The small machine-readable summaries under _summary/ are kept as evidence.
scripts/spike/samples/*
!scripts/spike/samples/_summary/
