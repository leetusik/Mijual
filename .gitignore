# Secrets
.env
.env.*
# ...but the committed production env TEMPLATE (names + purpose, no values).
# P4.S1: `.env.prod` itself is operator-created on the box and never committed.
!.env.prod.example

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# P2 pipeline: on-disk OpenDART response cache (regenerable; byte-compatible
# with the P1 spike cache below). Also holds the scheduler's file-lock fallback
# and (with `beat -s var/celerybeat-schedule`) beat's own last-run state.
var/

# P2.S6: celery beat's shelve DB when it is started without `-s var/...`.
celerybeat-schedule*
celerybeat.pid

# Node / Next.js (P5.S10: the frontend/ app)
node_modules/
.next/
dist/
# tsc --noEmit --incremental's cache; regenerated by `npm run typecheck`.
*.tsbuildinfo

# P4.S3: database dumps from deploy/db/backup.sh. They contain READER EMAIL
# ADDRESSES and PASSWORD HASHES — they live on the box, mode 600 in a 700
# directory, and never enter git.
deploy/backups/

# OS / editor
.DS_Store

# P1.S1 spike: raw DART response cache (~9MB, regenerable by re-running the scripts).
# The small machine-readable summaries under _summary/ are kept as evidence.
scripts/spike/samples/*
!scripts/spike/samples/_summary/
