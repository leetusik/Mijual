# 주주의관제탑 — compose `env_file` TEMPLATE (key names + purpose only, NO real values).
#
# This file is COMMITTED as the reference. The real file is `.env.prod`, created by
# the operator on the box beside compose.prod.yml, and is NEVER committed
# (.gitignore's `.env.*` keeps it out; only this `.example` is negated back in).
#
# Read by: mijual-api, mijual-worker, mijual-beat, mijual-schema and
# mijual-postgres. NOT by mijual-web — the frontend container holds no secret and
# has no env_file at all.
#
# Syntax: `KEY=value`, one per line, no `export`, no shell expansion. Keep it
# clean: no spaces around `=`.
#
# NOT IN THIS FILE, on purpose: `MIJUAL_API_ORIGIN`. It is baked into the frontend
# at BUILD time (next.config.ts resolves the rewrite destination then), so it rides
# compose.prod.yml's `build.args` AND that service's `environment:` — an env_file
# entry would arrive too late to affect the build.

# ---------------------------------------------------------------------------
# Database. THE COUPLING: POSTGRES_PASSWORD and the password inside DATABASE_URL
# are the same secret written twice — the container is initialised from the first
# and the app connects with the second. They must match, or the app gets
# `password authentication failed` against a Postgres that is perfectly healthy.
# (Note: POSTGRES_* are read by the postgres image only on FIRST init — changing
# them later does not change the existing role/database in mijual-pgdata.)
# ---------------------------------------------------------------------------
POSTGRES_USER=mijual
POSTGRES_DB=mijual
# Mint one: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Host is the compose SERVICE name on the project-internal network, port 5432
# (the container's own port — this stack publishes none).
DATABASE_URL=postgresql+psycopg://mijual:<POSTGRES_PASSWORD>@mijual-postgres:5432/mijual

# ---------------------------------------------------------------------------
# Redis — Celery broker, result backend, and the pipeline run-lock store.
# Optional to the API at request time (the ops lock chip degrades and the tab
# still answers); required by the worker and beat.
# ---------------------------------------------------------------------------
REDIS_URL=redis://mijual-redis:6379/0

# ---------------------------------------------------------------------------
# Secrets. Read in-process, never logged, never echoed; Settings masks them all.
# ---------------------------------------------------------------------------
# OpenDART auth — the collector's key. Needed by the worker; the API never calls
# OpenDART from a request path.
DART_API_KEY=
# The reading layer AND the AI 질문 agent. Resolved on first USE, so the API
# imports, boots and serves every other route without it — only a question fails.
GEMINI_API_KEY=
# Peppers the stored session / reset digests. Unset is a DEVELOPMENT state (unkeyed
# digests + one log warning) and must not ship. Rotating it logs every reader out,
# which is the intended emergency lever.
# Mint one: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
MIJUAL_SESSION_SECRET=
# The operator door: a SEPARATE credential with no join to any reader account and
# no admin flag on any row. Unset = the door never opens (and says so identically
# to a wrong password). The password is stored plaintext here and hashed once per
# process — it is never compared with `==`.
MIJUAL_OPS_ID=
MIJUAL_OPS_PASSWORD=

# ---------------------------------------------------------------------------
# Serving policy.
# ---------------------------------------------------------------------------
# `Secure` on both cookies. ON in production — this is the setting that is off
# locally on purpose (a Secure cookie over plain http silently never arrives).
MIJUAL_COOKIE_SECURE=1
# The origin the FRONTEND is served from, used to build the password-reset link.
# The public hostname, not the container's.
MIJUAL_APP_BASE_URL=https://jujutower.com
# The 운영자 연락처 the global footer publishes on every reader page and the agent
# hands out. PUBLIC by decision, not a secret — but it travels in NO commit (it
# lives in the dev repo-root `.env`), so the deploy copies it across by hand.
# Unset is invisible on the dev box and visible to every reader in production:
# the footer silently drops its two links and the agent answers 「연락처 미설정」.
MIJUAL_OPERATOR_CONTACT=

# ---------------------------------------------------------------------------
# vocky — the operator's separate service. Two halves: the ops 관찰 뷰 (read) and,
# since P8, the reader's 의견 보내기 send. Unset EITHER half and 의견 보내기 answers
# 503 feedback_unconfigured on a READER surface, not just a blank ops tab.
# The key is a `vk_`-prefixed secret and travels over https in a header.
# ---------------------------------------------------------------------------
MIJUAL_VOCKY_API_BASE=
MIJUAL_VOCKY_API_KEY=

# ---------------------------------------------------------------------------
# Optional. Both have working defaults; set them only to override.
# ---------------------------------------------------------------------------
# The KST wall-clock instant the landing countdown ticks down to on the 소멸 day.
# Default "24:00" = end of that day. The operator's real 접수 마감 시각 lands here
# with no code change.
#MIJUAL_COUNTDOWN_CUTOFF_TIME=24:00
# How old the corpus may get before the board says so. Default 18 (hours). The
# board never goes dark either way — it says how stale it is.
#MIJUAL_STALE_AFTER_HOURS=18

# --- mail (P4.S2 adds SMTP_* here) ---
# The D-day notification transport. P4.S2 fills this section in: the Namecheap
# Private Email transactional stream (`mail.privateemail.com`), SMTP_HOST / PORT /
# USER / PASS / FROM. It lands here rather than in its own file because the API,
# worker and beat all read THIS env_file — so a beat task can send.
